# Server-side (used by `npm run dev:server`)
GEMINI_API_KEY=your_server_side_gemini_key
# Compatibility fallback if you currently only have VITE key:
# VITE_GEMINI_API_KEY=your_key
PORT=8787
CORS_ORIGIN=*

# Frontend (used by Vite)
VITE_BACKEND_URL=http://localhost:8787
VITE_GOOGLE_FORM_ACTION_URL=
VITE_GOOGLE_FORM_RATING_ENTRY_ID=
VITE_GOOGLE_FORM_FEEDBACK_ENTRY_ID=
VITE_ANALYTICS_WEBHOOK_URL=
